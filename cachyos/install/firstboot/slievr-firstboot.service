[Unit]
Description=slievr first-boot desktop bootstrap
Documentation=file:///var/log/slievr-firstboot.log
After=network-online.target NetworkManager.service systemd-user-sessions.service
Wants=network-online.target
ConditionPathExists=!/var/lib/slievr-firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/slievr-firstboot.sh
# Mark done whether it succeeded or not, so it never loops on a bad boot.
ExecStartPost=/usr/bin/touch /var/lib/slievr-firstboot-done
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
