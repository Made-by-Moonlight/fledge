#!/usr/bin/env bash
# made by moonlight installer: asks everything up front, then hands over to
# mbm-install, which runs install-cachyos.sh --answers unattended.
#   mbm-configurator            live ISO, tty1, as root
#   mbm-configurator --dry-run  anywhere: walk every screen, print the answers
set -euo pipefail

MBM_REPO="${MBM_REPO:-/usr/share/slievr-cachy}"
MBM_ANSWERS="${MBM_ANSWERS:-/run/mbm-answers.env}"
MBM_OWL="${MBM_OWL:-/usr/share/mbm/owl.ansi}"
DRY_RUN=0
[[ "${1:-}" == --dry-run ]] && DRY_RUN=1

# shellcheck source=SCRIPTDIR/../../../../../../install/profile.sh
source "$MBM_REPO/cachyos/install/profile.sh"
# shellcheck source=SCRIPTDIR/../../../../../../install/lib/detect.sh
source "$MBM_REPO/cachyos/install/lib/detect.sh"
# shellcheck source=SCRIPTDIR/../../../../../../install/lib/answers.sh
source "$MBM_REPO/cachyos/install/lib/answers.sh"
# shellcheck source=SCRIPTDIR/../../../../../lib/mbm.sh
source "$MBM_REPO/cachyos/iso/lib/mbm.sh"

# gum colours are ANSI slots; on the live console .automated_script.sh has
# loaded the brand palette into them (3 accent, 0 background, 8 muted, 1 error).
export GUM_INPUT_CURSOR_FOREGROUND=3 GUM_INPUT_PROMPT_FOREGROUND=3
export GUM_CHOOSE_CURSOR_FOREGROUND=3 GUM_CHOOSE_SELECTED_FOREGROUND=3
export GUM_FILTER_INDICATOR_FOREGROUND=3 GUM_FILTER_MATCH_FOREGROUND=3
export GUM_CONFIRM_SELECTED_BACKGROUND=3 GUM_CONFIRM_SELECTED_FOREGROUND=0
export GUM_CONFIRM_PROMPT_FOREGROUND=7

header() { clear; gum style --foreground 3 --bold --margin "1 2" "$1"; }
note()   { gum style --foreground 8 --margin "0 2" -- "$@"; }
fail()   { gum style --foreground 1 --margin "0 2" -- "$@"; }

show_owl() {
  if [[ -r "$MBM_OWL" ]]; then
    cat "$MBM_OWL"
  elif command -v magick >/dev/null; then
    python3 "$MBM_REPO/cachyos/branding/render-console.py" \
      "$MBM_REPO/cachyos/branding/owl.svg" --cols 40 --ansi || true
  fi
}

welcome() {
  clear
  show_owl
  echo
  gum style --bold --margin "0 2" "m a d e   b y   m o o n l i g h t"
  note "CachyOS · Hyprland · encrypted btrfs"
  echo
  gum confirm --affirmative "Let's go" --negative "Shell" \
    "Install made by moonlight on this machine?" || exit 130
}

# If no networks parse, iwctl itself opens as the fallback.
wifi_connect() {
  local dev ssid pass
  dev="$({ iwctl device list 2>/dev/null || true; } | sed 's/\x1b\[[0-9;]*m//g' | awk '$NF == "station" {print $1; exit}')" || dev=""
  if [[ -z "$dev" ]]; then fail "No Wi-Fi device found."; sleep 2; return; fi
  iwctl station "$dev" scan || true; sleep 3
  mapfile -t nets < <({ iwctl station "$dev" get-networks 2>/dev/null || true; } | parse_networks)
  if (( ${#nets[@]} == 0 )); then
    note "Couldn't list networks; opening iwctl. Type 'exit' when connected."
    iwctl || true; return
  fi
  ssid="$(printf '%s\n' "${nets[@]}" | gum choose --header "Wi-Fi network")" || return
  pass="$(read_secret "Passphrase for $ssid")" || return
  iwctl --passphrase "$pass" station "$dev" connect "$ssid" || fail "Couldn't connect to $ssid."
  sleep 3
}

ensure_online() {
  while ! mbm_online; do
    header "No internet connection"
    note "The install downloads packages, so it needs a connection."
    case "$(gum choose "Connect to Wi-Fi" "Retry" "Shell")" in
      "Connect to Wi-Fi") wifi_connect ;;
      Retry) ;;
      *) exit 130 ;;
    esac
  done
}

ask_hostname() {
  local h="${HOST:-}"
  header "1 / 5 · Hostname"
  note "The machine's name on your network."
  while true; do
    h="$(gum input --placeholder "e.g. glaux" --value "$h")"
    valid_hostname "$h" && break
    fail "Use lowercase letters, digits and '-', up to 63 characters."
  done
  HOST="$h"
}

ask_timezone() {
  header "2 / 5 · Timezone"
  note "Type to search. Default: $TIMEZONE"
  TZ_CHOICE=""
  until [[ -n "$TZ_CHOICE" && "$TZ_CHOICE" != *..* && -f "/usr/share/zoneinfo/$TZ_CHOICE" ]]; do
    TZ_CHOICE="$( { echo "$TIMEZONE"; timedatectl list-timezones | grep -vxF "$TIMEZONE"; } \
      | gum filter --height 12)" || TZ_CHOICE=""
  done
}

# <placeholder>  ->  prints the secret. Typed hidden; "Show" reveals it to check
# before use. Runs inside $(...), so everything drawn goes to stderr.
read_secret() {
  local s
  while true; do
    s="$(gum input --password --placeholder "$1")" || return 1
    while true; do
      case "$(gum choose "Continue" "Show" "Retype")" in
        Continue) printf '%s' "$s"; return 0 ;;
        Show) note "You typed: $s" >&2 ;;
        Retype) break ;;
        *) return 1 ;;
      esac
    done
  done
}

read_twice() { # <label>  ->  prints the confirmed, non-empty secret
  local p1 p2
  while true; do
    p1="$(read_secret "$1")" || exit 130
    p2="$(gum input --password --placeholder "Confirm $1")"
    [[ -n "$p1" && "$p1" == "$p2" ]] && { printf '%s' "$p1"; return; }
    fail "Empty, or they don't match. Try again." >&2
  done
}

ask_account() {
  local u=""
  header "3 / 5 · Account"
  note "Your login name. The root account stays locked; you'll use sudo."
  while true; do
    u="$(gum input --placeholder "Username, e.g. ethan" --value "$u")" || exit 130
    valid_username "$u" && break
    fail "Start with a lowercase letter; then lowercase letters, digits, '_' or '-', up to 32."
  done
  USERNAME="$u"
  note "Password for $USERNAME:"
  USER_PW="$(read_twice "password")"
  local rc=0
  gum confirm "Use the same passphrase to unlock the disk at boot?" || rc=$?
  case "$rc" in
    0) LUKS_PW="$USER_PW" ;;
    1) LUKS_PW="$(read_twice "disk passphrase")" ;;
    *) exit 130 ;;
  esac
}

ask_disk() {
  local line kname typed disks
  header "4 / 5 · Disk"
  note "The disk you pick is erased completely. USB drives and this installer are hidden."
  mapfile -t disks < <(list_disks | awk '$NF != "usb"')
  (( ${#disks[@]} )) || { fail "No installable disks found."; exit 1; }
  while true; do
    line="$(printf '%s\n' "${disks[@]}" | gum choose --height 10)"
    kname="${line%% *}"
    fail "Everything on this disk will be destroyed:" "  $line"
    typed="$(gum input --placeholder "Type confirm to erase it, or leave empty to pick again")"
    [[ "${typed,,}" == confirm ]] && break
    note "Not confirmed. Pick the disk again."
  done
  DISK_PATH="$(disk_by_id "$kname")"
}

summary() {
  local ucode gpu memkb keep
  ucode="$(detect_ucode /proc/cpuinfo || true)"
  gpu="$(detect_gpu_pkgs "$(lspci -nn 2>/dev/null || true)")"
  memkb="$(awk '/^MemTotal:/{print $2}' /proc/meminfo)"
  mapfile -t keep < <(filter_fstab_entries "$(blkid -s UUID -o value 2>/dev/null || true)" "${EXTRA_FSTAB_ENTRIES[@]}")
  header "5 / 5 · Ready to install"
  gum style --margin "0 2" \
    "Hostname    $HOST" \
    "Timezone    $TZ_CHOICE" \
    "Account     $USERNAME (root locked)" \
    "Disk        $DISK_PATH" \
    "Microcode   $ucode" \
    "GPU         ${gpu:-generic}" \
    "Memory      $(( memkb / 1024 )) MiB, zram $(zram_size "$memkb") MiB" \
    "Data disks  ${#keep[@]} of ${#EXTRA_FSTAB_ENTRIES[@]} fstab entries present"
  if (( ${#keep[@]} )); then
    gum style --foreground 8 --margin "0 2" -- "${keep[@]/#/  }"
  else
    note "  none on this machine"
  fi
  echo
}

# A failed install leaves the target mounted at /mnt (for inspection) and the
# LUKS mapping open; the installer refuses to start over those.
cleanup_previous() {
  local err
  header "A previous install attempt is still open"
  note "/mnt is mounted and/or /dev/mapper/$LUKS_NAME is open."
  case "$(gum choose "Clean up the previous attempt" "Shell")" in
    "Clean up the previous attempt")
      if mountpoint -q /mnt && ! err="$(umount -R /mnt 2>&1)"; then
        fail "umount -R /mnt failed: $err"; note "Close what uses /mnt, then run mbm-configurator again."; exit 1
      fi
      if [[ -e "/dev/mapper/$LUKS_NAME" ]] && ! err="$(cryptsetup close "$LUKS_NAME" 2>&1)"; then
        fail "cryptsetup close $LUKS_NAME failed: $err"; note "Fix that, then run mbm-configurator again."; exit 1
      fi ;;
    *) exit 130 ;;
  esac
}
if (( ! DRY_RUN )) && { mountpoint -q /mnt || [[ -e "/dev/mapper/$LUKS_NAME" ]]; }; then
  cleanup_previous
fi

welcome
ensure_online
while true; do
  ask_hostname; ask_timezone; ask_account; ask_disk
  summary
  rc=0; gum confirm --affirmative "Install" --negative "Back" "Erase $DISK_PATH and install?" || rc=$?
  case "$rc" in
    0) break ;;
    1) ;;
    *) exit 130 ;;
  esac
done

answers=(
  "DISK=$DISK_PATH" "DISK_CONFIRMED=yes" "HOSTNAME=$HOST" "TIMEZONE=$TZ_CHOICE"
  "USERNAME=$USERNAME" "USER_PASSWORD=$USER_PW" "LUKS_PASSPHRASE=$LUKS_PW"
)
if (( DRY_RUN )); then
  tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
  write_answers "$tmp" "${answers[@]}"
  echo; note "Dry run. install-cachyos.sh --answers would receive:"; mask_answers "$tmp"
  exit 0
fi
write_answers "$MBM_ANSWERS" "${answers[@]}"
exec mbm-install "$MBM_ANSWERS"
