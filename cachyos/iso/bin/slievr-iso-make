#!/usr/bin/env bash
# Build the made by moonlight installer ISO from this repo's committed HEAD.
#   cachyos/iso/bin/slievr-iso-make   ->  release/fledge-*.iso (+ .sha256)
# Needs docker (running; sudo is used if you're not in the docker group).
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
REPO="$(git -C "$HERE" rev-parse --show-toplevel)"
RELEASE="$REPO/release"
die() { echo "slievr-iso-make: $*" >&2; exit 1; }

# One source of truth for the GitHub URL (also used by bootstrap.sh).
DOTFILES_REPO="$(sed -n 's/^DOTFILES_REPO="\(.*\)"$/\1/p' "$REPO/cachyos/bootstrap.sh")"
[[ -n "$DOTFILES_REPO" ]] || die "couldn't read DOTFILES_REPO from cachyos/bootstrap.sh"

if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
  echo "WARNING: uncommitted changes are NOT in the ISO (it ships HEAD $(git -C "$REPO" rev-parse --short HEAD)):" >&2
  git -C "$REPO" status --short >&2
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
git clone -q --no-hardlinks "$REPO" "$work/src"
git -C "$work/src" remote set-url origin "$DOTFILES_REPO"

# The clone's refs/remotes/origin/* are the host's local branches, not GitHub's.
branch="$(git -C "$work/src" symbolic-ref --short HEAD 2>/dev/null || true)"
[[ "$branch" == main ]] || echo "WARNING: building from branch '${branch:-detached HEAD}', not main." >&2
git -C "$work/src" for-each-ref --format='%(refname)' refs/remotes/origin \
  | while read -r ref; do git -C "$work/src" update-ref -d "$ref"; done
if [[ -n "$branch" ]]; then
  rc=0; git ls-remote --exit-code --heads "$DOTFILES_REPO" "$branch" >/dev/null 2>&1 || rc=$?
  if (( rc == 0 )); then
    git -C "$work/src" config "branch.$branch.remote" origin
    git -C "$work/src" config "branch.$branch.merge" "refs/heads/$branch"
  else
    git -C "$work/src" branch --unset-upstream 2>/dev/null || true
    if (( rc == 2 )); then
      echo "NOTE: $branch isn't on GitHub; the installed repo has no upstream (git pull won't work until it's pushed or switched to main)." >&2
    else
      echo "WARNING: couldn't reach GitHub to check for branch $branch (ls-remote exit $rc); the installed repo has no upstream." >&2
    fi
  fi
fi
mkdir -p "$RELEASE"

command -v docker >/dev/null || die "docker is not installed"
DOCKER=(docker)
docker version >/dev/null 2>&1 || DOCKER=(sudo docker)   # not in the docker group
"${DOCKER[@]}" pull -q archlinux/archlinux:latest
"${DOCKER[@]}" run --rm --privileged \
  -v "$work/src:/src:ro" -v "$RELEASE:/release" \
  -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
  archlinux/archlinux:latest /src/cachyos/iso/builder/build-iso.sh

# shellcheck disable=SC2012  # our own ISO names, no odd characters
ls -1t "$RELEASE"/*.iso | head -n1
