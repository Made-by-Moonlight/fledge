#!/usr/bin/env bash
# Boot a made by moonlight ISO in the disposable libvirt test VM.
#   cachyos/iso/bin/fledge-iso-boot [path/to.iso]   (default: newest release/*.iso)
# Run cachyos/vm/destroy-vm.sh first if the VM already exists.
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
REPO="$(git -C "$HERE" rev-parse --show-toplevel)"
iso="${1:-$(find "$REPO/release" -maxdepth 1 -name '*.iso' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)}"
[[ -f "$iso" ]] || { echo "no ISO; build one with cachyos/iso/bin/fledge-iso-make" >&2; exit 1; }

# host-deps.sh grants libvirt-qemu traverse rights on this cache dir only.
cache="${ISO_CACHE_DIR:-$HOME/.cache/cachyos-iso}"
mkdir -p "$cache"
cp -f "$iso" "$cache/"
ISO_PATH="$cache/${iso##*/}" "$REPO/cachyos/vm/provision-vm.sh"
echo "Open the console: virt-viewer --connect qemu:///system cachyos-test"

# virt-install's first boot powers the VM off at the installer's reboot
# instead of restarting it. Wait for that, then boot the installed system.
V=(virsh -c qemu:///system)
echo "Waiting for the install to finish and the VM to power off (Ctrl-C stops waiting)..."
until [[ "$("${V[@]}" domstate cachyos-test 2>/dev/null)" == "shut off" ]]; do sleep 10; done
"${V[@]}" start cachyos-test
echo "Booting the installed system."
