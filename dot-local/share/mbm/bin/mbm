#!/usr/bin/env bash
# mbm: made by moonlight desktop CLI.
#   mbm settings get|set|reset|check|apply ...   (lib/settings.sh)
#   mbm dmenu [--prompt P] [--select N] [--input-only]   (lib/dmenu.sh)
# Design: docs/superpowers/specs/2026-10-10-mbm-shell-design.md
set -euo pipefail

MBM_ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"

usage() { sed -n '3,4p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  settings)
    shift
    # shellcheck source=../lib/settings.sh
    source "$MBM_ROOT/lib/settings.sh"
    settings_main "$@"
    ;;
  dmenu)
    shift
    # shellcheck source=../lib/dmenu.sh
    source "$MBM_ROOT/lib/dmenu.sh"
    dmenu_main "$@"
    ;;
  -h | --help | "") usage ;;
  *) echo "mbm: unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
