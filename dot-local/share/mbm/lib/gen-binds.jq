# Input: merged settings. Output: Hyprland bind lines (raw text, jq -r).
def ipc: capture("^(?<t>[^. ]+)\\.(?<f>\\S+)(?<rest>.*)$") | "qs -c mbm ipc call \(.t) \(.f)\(.rest)";
def target($a):
  if $a.shell then "exec, " + ($a.shell | ipc)
  elif $a.dispatch then ($a.dispatch | capture("^(?<d>\\S+)\\s*(?<args>.*)$") | if .args == "" then "\(.d)," else "\(.d), \(.args)" end)
  else "exec, " + $a.exec end;

"# Generated by `mbm settings apply` from ~/.config/mbm/settings.json over the",
"# shipped defaults. Do not edit: change settings (or the defaults) instead.",
"",
(.binds | to_entries | sort_by(.value.group, .key)[] | .value as $b
 | ($b.action | if type == "array" then .[] else . end) as $a
 | "bind\($b.flags // "")d = \($b.mods), \($b.key), \($b.label), \(target($a))"),
"",
"# Key recording in the settings window: an empty submap, so every key reaches",
"# the window. SUPER+CTRL+ALT+Escape always gets out (e.g. if the shell died).",
"submap = mbm-record",
"bind = SUPER CTRL ALT, Escape, submap, reset",
"submap = reset"
