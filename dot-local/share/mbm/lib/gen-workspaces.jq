# Input: merged settings. Output: Hyprland workspace rules, numeric order.
# The lowest-numbered workspace pinned to each monitor is that monitor's
# default (Hyprland's default:true), so the settings carry no default field.
"# Generated by `mbm settings apply`. Do not edit.",
((.workspaces // {}) | to_entries
 | map({n: (.key | tonumber), m: .value.monitor, p: (.value.persistent == true)})
 | sort_by(.n) as $ws
 | ($ws | group_by(.m) | map(min_by(.n).n)) as $defaults
 | $ws[] | .n as $n
 | "workspace = \($n), monitor:\(.m)"
   + (if .p then ", persistent:true" else "" end)
   + (if any($defaults[]; . == $n) then ", default:true" else "" end))
