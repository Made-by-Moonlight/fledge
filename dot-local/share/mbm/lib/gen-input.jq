# Input: merged settings (defaults guarantee every field). Output: Hyprland input block.
.input as $i
| "# Generated by `mbm settings apply`. Do not edit.",
  "input {",
  "  kb_layout = \($i.kbLayout)",
  "  kb_variant = \($i.kbVariant)",
  "  kb_options = \($i.kbOptions)",
  "  repeat_rate = \($i.repeatRate)",
  "  repeat_delay = \($i.repeatDelay)",
  "  numlock_by_default = \($i.numlock)",
  "  sensitivity = \($i.sensitivity)",
  "  touchpad {",
  "    natural_scroll = \($i.touchpad.naturalScroll)",
  "    tap-to-click = \($i.touchpad.tapToClick)",
  "    scroll_factor = \($i.touchpad.scrollFactor)",
  "  }",
  "}"
