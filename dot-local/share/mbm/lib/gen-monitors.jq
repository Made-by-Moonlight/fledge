# Input: merged settings. Output: Hyprland monitor rules; the catch-all rule last.
"# Generated by `mbm settings apply`. Do not edit.",
(.displays // {} | to_entries | sort_by(.key)[] | .key as $n | .value as $d
 | if $d.enabled == false then "monitor = \($n), disable"
   else "monitor = \($n), \($d.mode // "preferred"), \($d.position // "auto"), \($d.scale // "auto")"
        + (if ($d.transform // 0) != 0 then ", transform, \($d.transform)" else "" end)
   end),
"monitor = , preferred, auto, auto"
