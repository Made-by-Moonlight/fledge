#!/bin/bash

# slievr:summary=Enable, disable, toggle, or recover mirroring the internal display to an external monitor
# slievr:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/hypr-toggles/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

# Get names dynamically
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)
# Get the first available external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP") | not).name' | head -n 1)

enable() {
  if [[ -z "$EXTERNAL" ]]; then
    notify-send -u low "󰍹    No external monitors found for mirror"
    exit 1
  fi

  if [[ -z "$INTERNAL" ]]; then
    notify-send -u low "󰍹    No laptop monitor found to mirror"
    exit 1
  fi

  if slievr-hyprland-toggle-enabled "$DISABLE_TOGGLE"; then
    slievr-hyprland-toggle "$DISABLE_TOGGLE"
  fi

  if slievr-hyprland-toggle-disabled "$TOGGLE"; then
    mkdir -p "${TOGGLE_FLAG%/*}"
    printf 'hl.monitor({ output = %s, mode = "preferred", position = "auto", scale = 1, mirror = %s })\n' \
      "$(fledge hypr quote "$EXTERNAL")" "$(fledge hypr quote "$INTERNAL")" >"$TOGGLE_FLAG"
    notify-send -u low "󰍹    Mirroring enabled ($EXTERNAL)"
    hyprctl reload
  fi
}

disable() {
  if slievr-hyprland-toggle-enabled "$TOGGLE"; then
    slievr-hyprland-toggle --disabled-notification "󰍹    Extended mode restored" "$TOGGLE"
  fi
}

recover() {
  if ! slievr-hw-external-monitors && slievr-hyprland-toggle-enabled "$TOGGLE"; then
    slievr-hyprland-toggle "$TOGGLE"
  fi
}

case "$1" in
  on) enable ;;
  off) disable ;;
  toggle) if slievr-hyprland-toggle-enabled "$TOGGLE"; then disable; else enable; fi ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
