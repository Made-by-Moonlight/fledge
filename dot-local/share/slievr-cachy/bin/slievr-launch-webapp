#!/bin/bash

# slievr:summary=Launch a URL as a web app in Zen
# slievr:args=<url>
#
# Not Chromium's --app= mode: this setup uses Zen (Firefox-based), which
# has no equivalent single-flag "app window" mode — its real "Web App"
# feature is GUI-only (Zen menu > turn a pinned tab into one), not
# scriptable. --kiosk was tried as the closest CLI approximation but
# crashes/exits after a few seconds on this Zen build (confirmed via
# journalctl — ~6s runtime vs. the tens of seconds to minutes a plain
# --new-window session stays open); reverted to plain --new-window
# until a userChrome.css-based approach (hides the toolbar without
# kiosk mode) is worth the extra setup. Opens with the full browser
# chrome (URL bar, tabs) as a result — a known, accepted gap for now.
# windowrule matching for these (see windows.conf) needs to key off
# window title, not window class, since there's no --app=<url>-derived
# class like Chromium gives.

exec setsid uwsm-app -- zen-browser --new-window "$1" "${@:2}"
