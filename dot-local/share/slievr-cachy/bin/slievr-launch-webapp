#!/bin/bash

# slievr:summary=Launch a URL as a web app in Zen
# slievr:args=<url>
#
# Not Chromium's --app= mode: this setup uses Zen (Firefox-based), which
# has no equivalent single-flag "app window" mode. Opens a plain new
# window instead — windowrule matching for these (see windows.conf)
# needs to key off window title, not window class, as a result.

exec setsid uwsm-app -- zen-browser --new-window "$1" "${@:2}"
