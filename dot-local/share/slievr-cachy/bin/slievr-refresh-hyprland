#!/bin/bash

# slievr:summary=Overwrite all the user configs in ~/.config/hypr with the Omarchy defaults.

slievr-refresh-config hypr/autostart.conf
slievr-refresh-config hypr/bindings.conf
slievr-refresh-config hypr/input.conf
slievr-refresh-config hypr/looknfeel.conf
slievr-refresh-config hypr/hyprland.conf
slievr-refresh-config hypr/monitors.conf
bash "$OMARCHY_PATH/install/config/detect-keyboard-layout.sh"
