#!/bin/bash

# slievr:summary=Regenerate the Hyprland binds, monitors and input from mbm settings and reload Hyprland.

# The Hyprland config itself (~/.config/hypr: hyprland.lua and fledge/) is the
# stowed repo, so there is no default to copy over it any more; what can go
# stale is the generated part. apply regenerates it and reloads Hyprland.
set -euo pipefail

mbm settings apply
echo "Hyprland config regenerated and reloaded."
