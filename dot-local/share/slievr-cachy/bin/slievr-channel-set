#!/bin/bash

# slievr:summary=Set the Omarchy channel, which dictates what git branch and package repository is used.
# slievr:args=<stable|rc|edge|dev>
# slievr:requires-sudo=true

if (($# == 0)); then
  echo "Usage: slievr-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") slievr-branch-set "master" && slievr-refresh-pacman "stable" ;;
"rc") slievr-branch-set "rc" && slievr-refresh-pacman "rc" ;;
"edge") slievr-branch-set "master" && slievr-refresh-pacman "edge" ;;
"dev") slievr-branch-set "dev" && slievr-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

slievr-update -y
