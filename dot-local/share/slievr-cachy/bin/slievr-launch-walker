#!/bin/bash

# slievr:summary=Compat shim: walker is gone. dmenu calls go to `mbm dmenu`, modes to the mbm launcher.
# Deleted with the rest of the slievr-* scripts in project B.

args=()
mode=""
dmenu=false
while (($#)); do
  case "$1" in
    --dmenu) dmenu=true ;;
    -p) args+=(--prompt "${2%…}"); shift ;;
    -c) args+=(--select "$2"); shift ;;
    --inputonly) args+=(--input-only) ;;
    -m) mode="$2"; shift ;;
    --width | --minheight | --maxheight | -t | --theme) shift ;;
  esac
  shift
done

if [[ $dmenu == true ]]; then
  exec mbm dmenu "${args[@]}"
fi
case "$mode" in
  clipboard) exec qs -c mbm ipc call launcher open clipboard ;;
  symbols) exec qs -c mbm ipc call launcher open emoji ;;
  menus:*)
    # elephant's Lua menus (themes, backgrounds, unlocks) were deleted with it;
    # say so instead of opening an unrelated launcher.
    notify-send -u low "${mode#menus:} isn't available in the mbm shell yet"
    exit 1 ;;
  *) exec qs -c mbm ipc call launcher open apps ;;
esac
