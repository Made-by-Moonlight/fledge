#!/bin/bash

# slievr:summary=Run the full Omarchy update pipeline
# slievr:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
slievr-update-keyring
slievr-update-available-reset
slievr-update-system-pkgs
slievr-migrate
slievr-update-aur-pkgs
slievr-update-orphan-pkgs
slievr-hook post-update

slievr-update-analyze-logs

slievr-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
