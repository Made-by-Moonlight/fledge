#!/bin/bash

# slievr:summary=Install Steam and graphics drivers selected for this system
# slievr:requires-sudo=true

set -e

echo "Installing Steam..."
slievr-pkg-add steam
slievr-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
