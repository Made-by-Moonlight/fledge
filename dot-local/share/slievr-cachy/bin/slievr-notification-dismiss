#!/bin/bash

# slievr:summary=Dismiss a mako notification on the basis of its summary. Used by the first-run notifications to dismiss them after clicking for action.
# slievr:args=<summary>

if (($# == 0)); then
  echo "Usage: slievr-notification-dismiss <summary>"
  exit 1
fi

# Compat shim (project B removes it): the mbm shell shows notifications.
exec qs -c mbm ipc call notifications dismissSummary "$1"
