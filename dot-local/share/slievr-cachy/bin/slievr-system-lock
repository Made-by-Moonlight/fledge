#!/bin/bash

# slievr:summary=Lock the computer and turn off the display
# slievr:group=system
# slievr:name=lock
# slievr:examples=omarchy system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    slievr-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.omarchy.screensaver

if [[ ${SLIEVR_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    slievr-brightness-keyboard off
    slievr-brightness-display off
  ) &
fi
