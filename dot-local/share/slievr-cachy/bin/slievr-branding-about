#!/bin/bash

# slievr:summary=Edit, set, or reset About branding
# slievr:group=branding
# slievr:name=about
# slievr:args=<image|text|reset>
# slievr:examples=omarchy branding about image | omarchy branding about text | omarchy branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(slievr-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && slievr-transcode-ascii "$image" ~/.config/omarchy/branding/about.txt --width 54 --height 26 --mode block; then
    slievr-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  slievr-launch-editor ~/.config/omarchy/branding/about.txt >/dev/null 2>&1 && slievr-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/icon.txt" ~/.config/omarchy/branding/about.txt && slievr-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: slievr-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
