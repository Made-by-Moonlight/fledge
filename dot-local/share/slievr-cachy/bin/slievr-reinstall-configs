#!/bin/bash

# slievr:summary=Reset all Omarchy user configs to the defaults
# slievr:requires-sudo=true

set -e

# Overwrite all user configs with the Omarchy defaults.

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting all Omarchy configs"
cp -R ~/.local/share/omarchy/config/* ~/.config/
cp ~/.local/share/omarchy/default/bashrc ~/.bashrc
echo '[[ -f ~/.bashrc ]] && . ~/.bashrc' | tee ~/.bash_profile >/dev/null

$(bash $OMARCHY_PATH/install/config/theme.sh)

slievr-refresh-limine
slievr-refresh-plymouth
slievr-nvim-setup
