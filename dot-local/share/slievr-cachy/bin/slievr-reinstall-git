#!/bin/bash

# slievr:summary=Reinstall the Omarchy source directory from git

set -e

# Reinstall the Omarchy configuration directory from the git source.

git clone --depth=1 --branch master "https://github.com/basecamp/omarchy.git" ~/.local/share/slievr-new >/dev/null
mv $OMARCHY_PATH ~/.local/share/slievr-old
mv ~/.local/share/slievr-new $OMARCHY_PATH
