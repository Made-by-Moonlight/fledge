include "lua";
# Input: merged settings. Output: apps.lua, the window rules for Settings › Apps
# (jq -r): the default opacity on windows tagged default-opacity (rules.lua tags
# them), then per class its opacity and where it opens. Loaded after rules.lua,
# so an entry here wins over anything hard-coded there.

# Window rules match the whole class as a regex: escape it, so a class is
# matched as written (com.libretro.RetroArch's dots match only dots).
def class_re: gsub("(?<c>[\\\\.^$|?*+()\\[\\]{}])"; "\\\(.c)");
# "override": the value as given, not multiplied by Hyprland's active_opacity.
def opacity: "\(.active) override \(.inactive) override";
def rule($match; $field; $value): {match: $match} + {($field): $value};

"-- Generated by `fledge settings apply` from ~/.config/fledge/settings.json over the",
"-- shipped defaults. Do not edit: change them in Settings › Apps instead.",
"",
"-- Each rule runs on its own: one Hyprland refuses (a field renamed in a new",
"-- release, say) is listed in one notification at the end.",
"local failed = {}",
"local function rule(what, spec)",
"  local ok, err = pcall(hl.window_rule, spec)",
"  if not ok then failed[#failed + 1] = what .. \" (\" .. tostring(err) .. \")\" end",
"end",
"",
(.windows.opacity // empty
 | "rule(\"default opacity\", \(rule({tag: "default-opacity"}; "opacity"; opacity) | lua_value))"),
(.apps // {} | to_entries | sort_by(.key)[] | .key as $c | .value
 | (.opacity // empty | "rule(\($c | lua_str), \(rule({class: ($c | class_re)}; "opacity"; opacity) | lua_value))"),
   (.workspace // empty | "rule(\($c | lua_str), \(rule({class: ($c | class_re)}; "workspace"; tostring) | lua_value))"),
   (.monitor // empty | "rule(\($c | lua_str), \(rule({class: ($c | class_re)}; "monitor"; .) | lua_value))")),
"",
"if #failed > 0 then",
"  local text = \"fledge: apps.lua: these window rules didn't load: \" .. table.concat(failed, \"; \")",
"  io.stderr:write(text, \"\\n\")",
"  pcall(function()",
"    hl.notification.create({ text = text, timeout = 15000, icon = \"error\", color = \"rgb(ff5555)\" })",
"  end)",
"end"
