include "lua";
# Input: merged settings. Output: workspaces.lua, hl.workspace_rule calls in
# numeric order. The lowest-numbered workspace pinned to each monitor is that
# monitor's default (Hyprland's default = true), so the settings carry no
# default field.
"-- Generated by `fledge settings apply`. Do not edit.",
((.workspaces // {}) | to_entries
 | map({n: (.key | tonumber), m: .value.monitor, p: (.value.persistent == true)})
 | sort_by(.n) as $ws
 | ($ws | group_by(.m) | map(min_by(.n).n)) as $defaults
 | $ws[] | .n as $n
 | {workspace: ($n | tostring), monitor: .m}
   + (if .p then {persistent: true} else {} end)
   + (if any($defaults[]; . == $n) then {default: true} else {} end)
 | "hl.workspace_rule(\(lua_value))")
