include "lua";
# Input: merged settings. Output: monitors.lua, hl.monitor rules: connector
# rules first, then desc: rules (each group by key), the catch-all (output "")
# last. A monitor can match both; the later rule wins in Hyprland, so the
# description-keyed one (what Settings › Displays writes) overrides a connector one.
"-- Generated by `fledge settings apply`. Do not edit.",
(.displays // {} | to_entries | sort_by([(.key | startswith("desc:")), .key])[] | .key as $n | .value as $d
 | if $d.enabled == false then {output: $n, disabled: true}
   else {output: $n, mode: ($d.mode // "preferred"), position: ($d.position // "auto"), scale: ($d.scale // "auto")}
        + (if ($d.transform // 0) != 0 then {transform: $d.transform} else {} end)
   end
 | "hl.monitor(\(lua_value))"),
"hl.monitor(\({output: "", mode: "preferred", position: "auto", scale: "auto"} | lua_value))"
