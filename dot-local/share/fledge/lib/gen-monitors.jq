include "lua";
# Input: merged settings. Output: monitors.lua, hl.monitor rules; the catch-all
# (output "") last.
"-- Generated by `fledge settings apply`. Do not edit.",
(.displays // {} | to_entries | sort_by(.key)[] | .key as $n | .value as $d
 | if $d.enabled == false then {output: $n, disabled: true}
   else {output: $n, mode: ($d.mode // "preferred"), position: ($d.position // "auto"), scale: ($d.scale // "auto")}
        + (if ($d.transform // 0) != 0 then {transform: $d.transform} else {} end)
   end
 | "hl.monitor(\(lua_value))"),
"hl.monitor(\({output: "", mode: "preferred", position: "auto", scale: "auto"} | lua_value))"
