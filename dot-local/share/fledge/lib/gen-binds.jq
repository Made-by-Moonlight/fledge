include "lua";
# Input: merged settings. Output: binds.lua, a Lua chunk of hl.bind calls (jq -r).
def ipc: capture("^(?<t>[^. ]+)\\.(?<f>\\S+)(?<rest>.*)$") | "qs -c fledge ipc call \(.t) \(.f)\(.rest)";
# One action -> a dispatcher expression. dsp names are checked against
# dsp-names.json before generation, so they are safe to splice in.
def dsp($a):
  if $a | has("shell") then "hl.dsp.exec_cmd(" + ($a.shell | ipc | lua_str) + ")"
  elif $a | has("exec") then "hl.dsp.exec_cmd(" + ($a.exec | lua_str) + ")"
  else "hl.dsp.\($a.dsp)(" + (if $a | has("args") then $a.args | lua_value else "" end) + ")" end;
# windows.switcher off: a bind meant for the switcher just cycles focus, as before it,
# and its submap step is dropped.
def switcher_off($a):
  if ($a.dsp? == "event") and ($a.args? | type == "string" and startswith("fledge-switcher ")) then
    [{dsp: "window.cycle_next"} + (if $a.args == "fledge-switcher prev" then {args: false} else {} end),
     {dsp: "window.bring_to_top"}]
  elif ($a.dsp? == "submap") and ($a.args? == "fledge-switcher") then []
  else [$a] end;
def action($switcher):
  if $switcher | not then [[.] | flatten[] | switcher_off(.)[]] | if length == 1 then .[0] else . end else . end
  | if type == "array" then "function() " + (map("hl.dispatch(" + dsp(.) + ")") | join(" ")) + " end"
  else dsp(.) end;
# Flag letters -> hl.bind options. 'm' has none: a mouse bind is just
# window.drag()/window.resize() bound to mouse:272/273. 's' (Hyprland's
# separate-keysyms flag) has no Lua option; check refuses it before this runs.
def flag_opts: {e: "repeating", l: "locked", r: "release", n: "non_consuming",
                t: "transparent", i: "ignore_mods", p: "dont_inhibit"};
def opts($b):
  ($b.flags // "" | split("") | map(flag_opts[.] // empty | {(.): true}) | add // {})
  + {description: $b.label};
def keys($b): [($b.mods | split(" ") | map(select(. != ""))[]), $b.key] | join(" + ");
# The window switcher's binds: those sending fledge-switcher next|prev (and entering its submap).
def switcher($dir): [.binds[] | select([.action] | flatten | any(.dsp? == "event" and .args? == "fledge-switcher \($dir)"))];
def ev($e): "hl.dsp.event(" + ("fledge-switcher \($e)" | lua_str) + ")";
def ev_reset($e): "function() hl.dispatch(\(ev($e))) hl.dispatch(hl.dsp.submap(\"reset\")) end";
# Inside the submap the same keys step on (held: repeating), arrows too, Return picks and
# Escape gives up, each leaving the submap in the same breath. Letting go of the bind's
# modifier picks too: hypr/fledge/switcher.lua, as a release bind can't see that.
def switcher_submap($switcher):
  (switcher("next") | map("hl.bind(\(keys(.) | lua_str), \(ev("next")), { repeating = true })")) as $next
  | (switcher("prev") | map("hl.bind(\(keys(.) | lua_str), \(ev("prev")), { repeating = true })")) as $prev
  | if ($next | length) == 0 or ($switcher | not) then empty else
      "",
      "-- The window switcher (switcher/Switcher.qml) while its bind's modifier is held.",
      "try(\"fledge-switcher submap\", function() hl.define_submap(\"fledge-switcher\", function()",
      (($next + $prev)[] | "  " + .),
      "  hl.bind(\"Right\", \(ev("next")), { repeating = true, ignore_mods = true })",
      "  hl.bind(\"Left\", \(ev("prev")), { repeating = true, ignore_mods = true })",
      "  hl.bind(\"Return\", \(ev_reset("commit")), { ignore_mods = true })",
      "  hl.bind(\"Escape\", \(ev_reset("cancel")), { ignore_mods = true })",
      "end) end)"
    end;

(.windows.switcher != false) as $switcher |
"-- Generated by `fledge settings apply` from ~/.config/fledge/settings.json over the",
"-- shipped defaults. Do not edit: change settings (or the defaults) instead.",
"",
"-- Each bind runs on its own: one that Hyprland refuses (a dispatcher renamed",
"-- in a new release, say) is listed in one notification at the end instead of",
"-- taking every bind after it down too.",
"local failed = {}",
"local function try(keys, fn)",
"  local ok, err = pcall(fn)",
"  if not ok then failed[#failed + 1] = keys .. \" (\" .. tostring(err) .. \")\" end",
"end",
"",
(.binds | to_entries | sort_by(.value.group, .key)[] | .value as $b
 | "try(\(keys($b) | lua_str), function() hl.bind(\(keys($b) | lua_str), \($b.action | action($switcher)), \(opts($b) | lua_value)) end)"),
"",
"-- Key recording in the settings window: an empty submap, so every key reaches",
"-- the window. SUPER+CTRL+ALT+Escape always gets out (e.g. if the shell died).",
"try(\"fledge-record submap\", function() hl.define_submap(\"fledge-record\", function() hl.bind(\"SUPER + CTRL + ALT + Escape\", hl.dsp.submap(\"reset\")) end) end)",
switcher_submap($switcher),
"",
"if #failed > 0 then",
"  local text = \"fledge: binds.lua: these binds didn't load: \" .. table.concat(failed, \"; \")",
"  io.stderr:write(text, \"\\n\")",
"  pcall(function()",
"    hl.notification.create({ text = text, timeout = 15000, icon = \"error\", color = \"rgb(ff5555)\" })",
"  end)",
"end"
