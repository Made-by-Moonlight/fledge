#!/bin/bash

# slievr:summary=Launch the Omarchy screensaver in the default terminal on the system with the correct font configuration.

if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f org.omarchy.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if slievr-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
qs -c mbm ipc call launcher close >/dev/null 2>&1

focused=$(slievr-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

# Each terminal is started by Hyprland (exec_cmd), on the monitor just focused.
exec_cmd() { fledge hypr dispatch "hl.dsp.exec_cmd($(fledge hypr quote "$*"))"; }

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  fledge hypr dispatch "hl.dsp.focus({ monitor = $(fledge hypr quote "$m") })"

  case $terminal in
  *Alacritty*)
    exec_cmd alacritty --class=org.omarchy.screensaver \
      --config-file ~/.local/share/omarchy/default/alacritty/screensaver.toml \
      -e slievr-screensaver
    ;;
  *ghostty*)
    exec_cmd ghostty --class=org.omarchy.screensaver \
      '--config-file=~/.local/share/omarchy/default/ghostty/screensaver' \
      --font-size=18 \
      -e slievr-screensaver
    ;;
  *foot*)
    exec_cmd foot --app-id=org.omarchy.screensaver \
      "--config=$OMARCHY_PATH/default/foot/screensaver.ini" \
      -e slievr-screensaver
    ;;
  *kitty*)
    exec_cmd kitty --class=org.omarchy.screensaver \
      --override font_size=18 \
      --override window_padding_width=0 \
      -e slievr-screensaver
    ;;
  *)
    notify-send -u low "✋  Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
    ;;
  esac
done

fledge hypr dispatch "hl.dsp.focus({ monitor = $(fledge hypr quote "$focused") })"
