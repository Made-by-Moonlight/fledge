#!/bin/bash

# Update system firmware using fwupd

set -e
echo -e "\e[32mUpdate Firmware\e[0m"

if fledge cmd missing fwupdmgr; then
  fledge pkg add fwupd
fi

# No copying fwupd's EFI binary onto the ESP (Omarchy put one in /boot/EFI/arch/):
# fledge boots Limine with UKIs from /boot, and fwupd places its own capsule
# loader there when an update needs one.

fwupdmgr refresh --force
sudo fwupdmgr update
