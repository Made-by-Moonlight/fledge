#!/bin/bash

# The fledge menu; a submenu name (capture, toggle, setup, ...) opens it directly.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | fledge launch walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.omarchy.terminal "$@"
}

# The command arrives as words (fledge <group> <action>), so all of them go on.
present_terminal() {
  fledge launch floating terminal with presentation "$@"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  fledge launch editor "$1"
}

# Hyprland doesn't reload on file changes (misc.disable_autoreload), and the
# editor runs detached, so a reload can't follow the save: say how to apply it.
open_hypr_config() {
  notify-send -u low "Editing config file" "$1
Save, then Setup › Config › Reload Hyprland (or hyprctl reload) to apply."
  fledge launch editor "$1"
}

reload_hyprland() {
  local out errors
  if ! out="$(hyprctl reload 2>&1)" || [[ $out == *error* ]]; then
    notify-send -u critical "Hyprland didn't reload" "$out"
    return
  fi
  # A reload with errors still answers ok; the errors are in configerrors.
  errors="$(hyprctl configerrors 2>/dev/null | sed '/^[[:space:]]*$/d')"
  if [[ -n $errors ]]; then
    notify-send -u critical "Hyprland reloaded with errors" "$errors"
  else
    notify-send -u low "Hyprland reloaded"
  fi
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n󰔎  Toggle\n  Hardware") in
  *Reminder*) show_reminder_menu ;;
  *Capture*) show_capture_menu ;;
  *Transcode*) fledge transcode || back_to show_trigger_menu ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) fledge reminder show ;;
  *"Clear all"*) fledge reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(fledge menu input "Remind in minutes")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    fledge notification send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(fledge menu input "Reminder message")

  if [[ -n $message ]]; then
    fledge reminder "$minutes" "$message"
  else
    fledge reminder "$minutes"
  fi
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in
  *Screenshot*) fledge capture screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) fledge capture text extraction ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_trigger_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

show_screenrecord_menu() {
  fledge capture screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio") fledge capture screenrecording ;;
  *"With desktop audio") fledge capture screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") fledge capture screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    fledge capture screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) fledge share clipboard ;;
  *File*) terminal bash -c "fledge share file" ;;
  *Folder*) terminal bash -c "fledge share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  local options="󱄄  Screensaver\n󰔎  Nightlight\n󱫖  Idle Lock\n󰂛  Notifications\n󰍜  Top Bar\n󱂬  Workspace Layout\n  Window Gaps\n  1-Window Ratio\n󰍹  Monitor Scaling\n  Direct Boot\n󰟵  Passwordless Sudo"

  case $(menu "Toggle" "$options") in
  *Screensaver*) fledge toggle screensaver ;;
  *Nightlight*) fledge toggle nightlight ;;
  *Idle*) fledge toggle idle ;;
  *Notifications*) fledge toggle notification silencing ;;
  *Bar*) fledge toggle waybar ;;
  *Layout*) fledge hyprland workspace layout toggle ;;
  *Ratio*) fledge hyprland window single square aspect toggle ;;
  *Gaps*) fledge hyprland window gaps toggle ;;
  *Scaling*) fledge hyprland monitor scaling cycle ;;
  *"Direct Boot"*) present_terminal fledge config direct boot ;;
  *"Passwordless Sudo"*) present_terminal fledge sudo passwordless ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_menu() {
  local options="󰛧  Laptop Display\n 󰍹  Mirror Display"

  if fledge hw hybrid gpu; then
    options="$options\n  Hybrid GPU"
  fi

  if fledge hw touchpad; then
    options="$options\n󰟸  Touchpad"
  fi

  if fledge hw dell xps haptic touchpad && fledge cmd present dell-xps-touchpad-haptics; then
    options="$options\n󰌌  Touchpad Haptics"
  fi

  if fledge hw touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Toggle" "$options") in
  *Laptop*) fledge hyprland monitor internal toggle ;;
  *Mirror*) fledge hyprland monitor internal mirror toggle ;;
  *Haptics*) show_hardware_touchpad_haptics_menu ;;
  *Touchpad*) fledge toggle touchpad ;;
  *Touchscreen*) fledge toggle touchscreen ;;
  *"Hybrid GPU"*) present_terminal fledge toggle hybrid gpu ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_touchpad_haptics_menu() {
  local current=$(dell-xps-touchpad-haptics get)
  local selected=$(menu "Touchpad Haptics" "low\nmid\nhigh" "" "$current")

  if [[ -n $selected ]]; then
    dell-xps-touchpad-haptics set "$selected"
  else
    back_to show_hardware_menu
  fi
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n󰟵  Unlock\n  Font\n  Background\n  Hyprland\n󱄄  Screensaver\n  About") in
  *Theme*) show_theme_menu ;;
  *Unlock*) fledge launch walker -m menus:omarchyunlocks --width 800 --minheight 400 ;;
  *Font*) show_font_menu ;;
  *Background*) show_background_menu ;;
  *Hyprland*) open_hypr_config ~/.config/hypr/fledge/looknfeel.lua ;;
  *Screensaver*) show_screensaver_menu ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) fledge branding about text ;;
  *Image*) fledge branding about image ;;
  *Default*) fledge branding about reset ;;
  *) show_style_menu ;;
  esac
}

show_screensaver_menu() {
  case $(menu "Screensaver" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) fledge branding screensaver text ;;
  *Image*) fledge branding screensaver image ;;
  *Default*) fledge branding screensaver reset ;;
  *) show_style_menu ;;
  esac
}

show_theme_menu() {
  fledge launch walker -m menus:omarchythemes --width 800 --minheight 400
}

show_background_menu() {
  fledge launch walker -m menus:omarchyBackgroundSelector --width 800 --minheight 400
}

show_font_menu() {
  theme=$(menu "Font" "$(fledge font list)" "--width 350" "$(fledge font current)")
  if [[ $theme == "CNCLD" || -z $theme ]]; then
    back_to show_style_menu
  else
    fledge font set "$theme"
  fi
}

show_setup_menu() {
  local options="  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n  System Sleep\n󰍹  Monitors\n  Keybindings\n  Input"
  options="$options\n  Defaults\n󰱔  DNS\n  Security\n  Time\n  Firmware\n  Restart\n  Config"

  # Audio, Wi-Fi, Bluetooth, monitors, binds and input belong to the mbm shell since the
  # cutover (wiremix and bluetui are gone; the hypr .conf files are generated).
  case $(menu "Setup" "$options") in
  *Audio*) qs -c mbm ipc call quicksettings open audio ;;
  *Wifi*) qs -c mbm ipc call quicksettings open wifi ;;
  *Bluetooth*) qs -c mbm ipc call quicksettings open bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *System*) show_setup_system_menu ;;
  *Monitors*) qs -c mbm ipc call settings open displays ;;
  *Keybindings*) qs -c mbm ipc call settings open keybinds ;;
  *Input*) qs -c mbm ipc call settings open input ;;
  *Defaults*) show_setup_default_menu ;;
  *DNS*) present_terminal fledge setup dns ;;
  *Security*) show_setup_security_menu ;;
  *Time*) show_setup_time_menu ;;
  *Firmware*) present_terminal fledge update firmware ;;
  *Restart*) show_setup_restart_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(fledge powerprofiles list)" "" "$(powerprofilesctl get)")

  if [[ $profile == "CNCLD" || -z $profile ]]; then
    back_to show_setup_menu
  else
    powerprofilesctl set "$profile"
  fi
}

show_setup_security_menu() {
  case $(menu "Security" "󰈷  Fingerprint\n  Fido2\n  Drive Encryption Password\n  User Password") in
  *Fingerprint*) present_terminal fledge setup security fingerprint ;;
  *Fido2*) present_terminal fledge setup security fido2 ;;
  *Drive*) present_terminal fledge drive password ;;
  *User*) present_terminal passwd ;;
  *) show_setup_menu ;;
  esac
}

show_setup_time_menu() {
  case $(menu "Time" "  Timezone\n  Sync Clock") in
  *Timezone*) present_terminal fledge tz select ;;
  *Sync*) present_terminal fledge update time ;;
  *) show_setup_menu ;;
  esac
}

# For a device, or the desktop shell (bar, launcher, notifications), that
# stopped responding. The shell is a user service: no terminal needed.
show_setup_restart_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth\n󰟸  Trackpad\n󰑓  Shell") in
  *Audio*) present_terminal fledge restart pipewire ;;
  *Wi-Fi*) present_terminal fledge restart wifi ;;
  *Bluetooth*) present_terminal fledge restart bluetooth ;;
  *Trackpad*) present_terminal fledge restart trackpad ;;
  *Shell*) systemctl --user restart mbm-shell.service ;;
  *) show_setup_menu ;;
  esac
}

show_setup_default_menu() {
  case $(menu "Default" "  Browser\n  Terminal\n  Editor") in
  *Browser*) show_setup_default_browser_menu ;;
  *Terminal*) show_setup_default_terminal_menu ;;
  *Editor*) show_setup_default_editor_menu ;;
  *) show_setup_menu ;;
  esac
}

browser_desktop_exists() {
  [[ -f ~/.local/share/applications/$1 || -f ~/.nix-profile/share/applications/$1 || -f /usr/share/applications/$1 ]]
}

show_setup_default_browser_menu() {
  local options=""
  browser_desktop_exists chromium.desktop && options="$options  Chromium"
  browser_desktop_exists google-chrome.desktop && options="${options:+$options\n}󰊯  Chrome"
  browser_desktop_exists brave-browser.desktop && options="${options:+$options\n}󰖟  Brave"
  browser_desktop_exists brave-origin-beta.desktop && options="${options:+$options\n}󰖟  Brave Origin"
  browser_desktop_exists microsoft-edge.desktop && options="${options:+$options\n}󰇩  Edge"
  browser_desktop_exists firefox.desktop && options="${options:+$options\n}󰈹  Firefox"
  browser_desktop_exists zen.desktop && options="${options:+$options\n}󰖟  Zen"

  local current=""
  case "$(fledge default browser)" in
  chromium) current="  Chromium" ;;
  chrome) current="󰊯  Chrome" ;;
  brave) current="󰖟  Brave" ;;
  brave-origin) current="󰖟  Brave Origin" ;;
  edge) current="󰇩  Edge" ;;
  firefox) current="󰈹  Firefox" ;;
  zen) current="󰖟  Zen" ;;
  esac

  case $(menu "Default Browser" "$options" "" "$current") in
  *Chromium*) fledge default browser chromium ;;
  *Chrome*) fledge default browser chrome ;;
  *"Brave Origin"*) fledge default browser brave-origin ;;
  *Brave*) fledge default browser brave ;;
  *Edge*) fledge default browser edge ;;
  *Firefox*) fledge default browser firefox ;;
  *Zen*) fledge default browser zen ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_terminal_menu() {
  local options=""
  fledge cmd present alacritty && options="$options  Alacritty"
  fledge cmd present foot && options="${options:+$options\n}  Foot"
  fledge cmd present ghostty && options="${options:+$options\n}  Ghostty"
  fledge cmd present kitty && options="${options:+$options\n}  Kitty"

  local current=""
  case "$(fledge default terminal)" in
  alacritty) current="  Alacritty" ;;
  foot) current="  Foot" ;;
  ghostty) current="  Ghostty" ;;
  kitty) current="  Kitty" ;;
  esac

  case $(menu "Default Terminal" "$options" "" "$current") in
  *Alacritty*) fledge default terminal alacritty ;;
  *Foot*) fledge default terminal foot ;;
  *Ghostty*) fledge default terminal ghostty ;;
  *Kitty*) fledge default terminal kitty ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_editor_menu() {
  local options=""
  fledge cmd present nvim && options="$options  Neovim"
  fledge cmd present code && options="${options:+$options\n}  VSCode"
  fledge cmd present cursor && options="${options:+$options\n}  Cursor"
  fledge cmd present zeditor && options="${options:+$options\n}  Zed"
  fledge cmd present sublime_text && options="${options:+$options\n}  Sublime Text"
  fledge cmd present helix && options="${options:+$options\n}  Helix"
  fledge cmd present vim && options="${options:+$options\n}  Vim"
  fledge cmd present emacs && options="${options:+$options\n}  Emacs"

  local current=""
  case "$(fledge default editor)" in
  nvim) current="  Neovim" ;;
  code) current="  VSCode" ;;
  cursor) current="  Cursor" ;;
  zed | zeditor) current="  Zed" ;;
  sublime_text) current="  Sublime Text" ;;
  helix) current="  Helix" ;;
  vim) current="  Vim" ;;
  emacs) current="  Emacs" ;;
  esac

  case $(menu "Default Editor" "$options" "" "$current") in
  *Neovim*) fledge default editor nvim ;;
  *VSCode*) fledge default editor code ;;
  *Cursor*) fledge default editor cursor ;;
  *Zed*) fledge default editor zed ;;
  *Sublime*) fledge default editor sublime_text ;;
  *Helix*) fledge default editor helix ;;
  *Vim*) fledge default editor vim ;;
  *Emacs*) fledge default editor emacs ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "Setup" "  Hyprland\n  Reload Hyprland\n  Hyprsunset\n󰒓  Settings\n󰞅  XCompose") in
  *Reload*) reload_hyprland ;;
  *Hyprland*) open_hypr_config ~/.config/hypr/hyprland.lua ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && fledge restart hyprsunset ;;
  *Settings*) qs -c mbm ipc call settings open "" ;;
  *XCompose*) open_in_editor ~/.XCompose && fledge restart xcompose ;;
  *) show_setup_menu ;;
  esac
}

show_setup_system_menu() {
  local options=""

  if fledge toggle enabled suspend-off; then
    options="$options󰒲  Enable Suspend"
  else
    options="$options󰒲  Disable Suspend"
  fi

  if fledge hibernation available; then
    options="$options\n󰤁  Disable Hibernate"
  else
    options="$options\n󰤁  Enable Hibernate"
  fi

  case $(menu "System" "$options") in
  *Suspend*) fledge toggle suspend ;;
  *"Enable Hibernate"*) present_terminal fledge hibernation setup ;;
  *"Disable Hibernate"*) present_terminal fledge hibernation remove ;;
  *) show_setup_menu ;;
  esac
}

show_about() {
  fledge launch about
}

show_system_menu() {
  local options="󱄄  Screensaver\n  Lock"
  ! fledge toggle enabled suspend-off && options="$options\n󰒲  Suspend"
  fledge hibernation available && options="$options\n󰤁  Hibernate"
  options="$options\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Screensaver*) fledge launch screensaver force ;;
  *Lock*) fledge system lock ;;
  *Suspend*) systemctl suspend ;;
  *Hibernate*) systemctl hibernate ;;
  *Logout*) fledge system logout ;;
  *Restart*) fledge system reboot ;;
  *Shutdown*) fledge system shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󱓞  Trigger\n  Style\n  Setup\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) qs -c mbm ipc call launcher open apps ;;
  *trigger*) show_trigger_menu ;;
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *reminder-set*) show_custom_reminder_input ;;
  *reminder*) show_reminder_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/omarchy/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
