#!/bin/bash

# Wrapper for swayosd-client that targets the currently focused monitor.
# usage: fledge swayosd client <swayosd-client-args...>

# Compat shim (project B removes it): swayosd is gone; messages and progress go to the fledge OSD.
icon="" message="" progress=-1
while (($#)); do
  case "$1" in
    --custom-icon) icon="$2"; shift ;;
    --custom-message) message="$2"; shift ;;
    --custom-progress) progress="$2"; shift ;;
    --custom-progress-text) [[ -z $message ]] && message="$2"; shift ;;
    --monitor) shift ;;
  esac
  shift
done
exec qs -c fledge ipc call osd popup "$icon" "$message" "$progress"
