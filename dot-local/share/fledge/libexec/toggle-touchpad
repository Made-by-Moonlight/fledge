#!/bin/bash

# Enable, disable, or toggle the touchpad
# usage: fledge toggle touchpad [on|off|toggle]

# A toggle snippet hyprland.lua loads, so the device stays off across reloads and logins.
STATE_CONF="$HOME/.local/state/hypr-toggles/touchpad-disabled.lua"

device="$(fledge hw touchpad)"

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

enable() {
  fledge hypr eval "hl.device({ name = $(fledge hypr quote "$device"), enabled = true })"
  rm -f "$STATE_CONF"
  fledge swayosd client --custom-icon input-touchpad-symbolic --custom-message "Touchpad enabled"
}

disable() {
  fledge hypr eval "hl.device({ name = $(fledge hypr quote "$device"), enabled = false })"
  mkdir -p "$(dirname "$STATE_CONF")"
  printf 'hl.device({ name = %s, enabled = false })\n' "$(fledge hypr quote "$device")" >"$STATE_CONF"
  fledge swayosd client --custom-icon touchpad-disabled-symbolic --custom-message "Touchpad disabled"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_CONF ]]; then enable; else disable; fi ;;
esac
