#!/bin/bash

# slievr:summary=Enable, disable, or toggle the touch functionality of the screen
# slievr:args=[on|off|toggle]

# A toggle snippet hyprland.lua loads, so the device stays off across reloads and logins.
STATE_CONF="$HOME/.local/state/hypr-toggles/touchscreen-disabled.lua"

device="$(slievr-hw-touchscreen)"

if [[ -z $device ]]; then
  echo "No touchscreen device found" >&2
  exit 1
fi

enable() {
  fledge hypr eval "hl.device({ name = $(fledge hypr quote "$device"), enabled = true })"
  rm -f "$STATE_CONF"
  slievr-swayosd-client --custom-icon device-support-touch-symbolic --custom-message "Touchscreen enabled"
}

disable() {
  fledge hypr eval "hl.device({ name = $(fledge hypr quote "$device"), enabled = false })"
  mkdir -p "$(dirname "$STATE_CONF")"
  printf 'hl.device({ name = %s, enabled = false })\n' "$(fledge hypr quote "$device")" >"$STATE_CONF"
  slievr-swayosd-client --custom-icon touch-disabled-symbolic --custom-message "Touchscreen disabled"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_CONF ]]; then enable; else disable; fi ;;
esac
