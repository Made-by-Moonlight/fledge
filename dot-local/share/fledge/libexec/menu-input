#!/bin/bash

# slievr:summary=Prompt for text input with Walker
# slievr:group=menu
# slievr:name=input
# slievr:args=prompt [walker args...]
# slievr:examples=omarchy menu input Reminder|slievr-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

slievr-launch-walker --dmenu --inputonly --width 295 --minheight 1 --maxheight 1 -p "$prompt…" "$@" 2>/dev/null
