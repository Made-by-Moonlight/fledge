#!/bin/bash

# Compat shim: walker is gone. dmenu calls go to `fledge dmenu`, modes to the shell's launcher.
# Goes with the rest of the vendored scripts in project B.

args=()
mode=""
dmenu=false
while (($#)); do
  case "$1" in
    --dmenu) dmenu=true ;;
    -p) args+=(--prompt "${2%…}"); shift ;;
    -c) args+=(--select "$2"); shift ;;
    --inputonly) args+=(--input-only) ;;
    -m) mode="$2"; shift ;;
    --width | --minheight | --maxheight | -t | --theme) shift ;;
  esac
  shift
done

if [[ $dmenu == true ]]; then
  exec fledge dmenu "${args[@]}"
fi
case "$mode" in
  clipboard) exec qs -c fledge ipc call launcher open clipboard ;;
  symbols) exec qs -c fledge ipc call launcher open emoji ;;
  menus:*)
    # elephant's Lua menus (themes, backgrounds, unlocks) were deleted with it;
    # say so instead of opening an unrelated launcher.
    case "$mode" in
      menus:omarchyBackgroundSelector) what="The background picker" ;;
      menus:omarchythemes) what="The theme picker" ;;
      menus:omarchyunlocks) what="The unlock menu" ;;
      *) what="This menu" ;;
    esac
    notify-send -u low "$what isn't available in the fledge shell yet"
    exit 1 ;;
  *) exec qs -c fledge ipc call launcher open apps ;;
esac
