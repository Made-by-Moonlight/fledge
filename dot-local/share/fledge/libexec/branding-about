#!/bin/bash

# Edit, set, or reset About branding
# usage: fledge branding about <image|text|reset>

set -euo pipefail

# fledge's vendored copy of Omarchy's default/ (Omarchy's $OMARCHY_PATH doesn't exist here).
DEFAULT="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../default"

case "${1:-}" in
image)
  image=$(fledge menu file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && fledge transcode ascii "$image" ~/.config/omarchy/branding/about.txt --width 54 --height 26 --mode block; then
    fledge launch about >/dev/null 2>&1
  fi
  ;;
text)
  fledge launch editor ~/.config/omarchy/branding/about.txt >/dev/null 2>&1 && fledge launch about >/dev/null 2>&1
  ;;
reset)
  cp "$DEFAULT/branding/about.txt" ~/.config/omarchy/branding/about.txt && fledge launch about >/dev/null 2>&1
  ;;
*)
  echo "Usage: fledge branding about <image|text|reset>" >&2
  exit 1
  ;;
esac
