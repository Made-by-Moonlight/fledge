#!/bin/bash

# Check if hibernation is supported

if [[ ! -f /sys/power/image_size ]]; then
  exit 1
fi

# Sum all swap sizes (excluding zram)
SWAPSIZE_KB=$(awk '!/Filename|zram/ {sum += $3} END {print sum+0}' /proc/swaps)
SWAPSIZE=$(( 1024 * ${SWAPSIZE_KB:-0} ))

HIBERNATION_IMAGE_SIZE=$(cat /sys/power/image_size)

# Set up means the running kernel knows where to resume from: resume= on its
# command line, whether the installer put it there or `fledge hibernation setup`
# did (its omarchy_resume.conf alone, before a reboot, doesn't resume anything).
if (( SWAPSIZE > HIBERNATION_IMAGE_SIZE )) && grep -qE '(^| )resume=' /proc/cmdline; then
  exit 0
else
  exit 1
fi
