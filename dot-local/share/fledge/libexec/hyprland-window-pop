#!/bin/bash

# Toggle to pop-out a tile to stay fixed on a display basis.
# usage: fledge hyprland window pop [width height x y]

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

active=$(hyprctl activewindow -j)
pinned=$(echo "$active" | jq ".pinned")
addr=$(echo "$active" | jq -r ".address")

# Hyprland's Lua dispatchers (fledge hypr); the window by address, as before.
win="$(fledge hypr quote "address:$addr")"

if [[ $pinned == "true" ]]; then
  fledge hypr eval "
    hl.dispatch(hl.dsp.window.pin({ window = $win }))
    hl.dispatch(hl.dsp.window.float({ action = \"toggle\", window = $win }))
    hl.dispatch(hl.dsp.window.tag({ tag = \"-pop\", window = $win }))"
elif [[ -n $addr ]]; then
  # Sizes and positions are numbers: anything else would be spliced into Lua.
  [[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] || { echo "width and height must be numbers" >&2; exit 1; }
  fledge hypr dispatch "hl.dsp.window.float({ action = \"toggle\", window = $win })"
  fledge hypr dispatch "hl.dsp.window.resize({ x = $width, y = $height, exact = true, window = $win })"

  if [[ -n $x && -n $y ]]; then
    [[ $x =~ ^-?[0-9]+$ && $y =~ ^-?[0-9]+$ ]] || { echo "x and y must be numbers" >&2; exit 1; }
    # moveactive x y moved by that much (relative), not to x,y.
    fledge hypr dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = true, window = $win })"
  else
    fledge hypr dispatch "hl.dsp.window.center({ window = $win })"
  fi

  fledge hypr eval "
    hl.dispatch(hl.dsp.window.pin({ window = $win }))
    hl.dispatch(hl.dsp.window.alter_zorder({ mode = \"top\", window = $win }))
    hl.dispatch(hl.dsp.window.tag({ tag = \"+pop\", window = $win }))"
fi
