#!/bin/bash

# Launch a floating terminal with the fledge presentation wrapper
# usage: fledge launch floating terminal with presentation <command>

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=fledge -e bash -c "fledge show logo; $cmd; if (( \$? != 130 )); then fledge show done; fi"
