#!/bin/bash

# Edit, set, or reset screensaver branding
# usage: fledge branding screensaver <image|text|reset>

set -euo pipefail

case "${1:-}" in
image)
  image=$(fledge menu file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && fledge transcode ascii "$image" ~/.config/omarchy/branding/screensaver.txt; then
    fledge launch screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  fledge launch editor ~/.config/omarchy/branding/screensaver.txt >/dev/null 2>&1 && fledge launch screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/logo.txt" ~/.config/omarchy/branding/screensaver.txt && fledge launch screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: fledge branding screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
