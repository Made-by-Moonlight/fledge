#!/bin/bash

# Toggle permanent Hyprland flags (Lua files) by copying them into a directory that's loaded entirely.
# usage: fledge hyprland toggle [--enabled-notification <text>] [--disabled-notification <text>] <flag-name>

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
# hyprland.lua loads every *.lua in ~/.local/state/hypr-toggles; the shipped
# toggles are snippets in ~/.config/hypr/fledge/toggles. Some toggles
# (internal-monitor-*) are written by their own scripts instead of copied.
FLAG="$HOME/.local/state/hypr-toggles/$FLAG_NAME.lua"
FLAG_SOURCE="$HOME/.config/hypr/fledge/toggles/$FLAG_NAME.lua"

if [[ -f $FLAG ]]; then
  rm "$FLAG"
  [[ -n $DISABLED_NOTIFICATION ]] && notify-send -u low "$DISABLED_NOTIFICATION"
elif [[ -f $FLAG_SOURCE ]]; then
  mkdir -p "${FLAG%/*}"
  cp "$FLAG_SOURCE" "$FLAG"
  [[ -n $ENABLED_NOTIFICATION ]] && notify-send -u low "$ENABLED_NOTIFICATION"
else
  echo "Flag not found: $FLAG_NAME"
  exit 1
fi

hyprctl reload
