#!/bin/bash

# Close all open windows

hyprctl clients -j | \
  jq -r ".[].address" | \
  while read -r addr; do
    fledge hypr dispatch "hl.dsp.window.close({ window = $(fledge hypr quote "address:$addr") })"
  done

# Move to first workspace
fledge hypr dispatch 'hl.dsp.focus({ workspace = 1 })'
