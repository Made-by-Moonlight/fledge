{
  "version": 2,
  "binds": {
    "apps.terminal": { "mods": "SUPER", "key": "RETURN", "label": "Terminal", "group": "Apps",
                       "action": { "exec": "uwsm app -- $TERMINAL" } },
    "shell.launcher": { "mods": "SUPER", "key": "SPACE", "label": "Launcher", "group": "Shell",
                        "action": { "shell": "launcher.toggle" } },
    "media.volume-up": { "mods": "", "key": "XF86AudioRaiseVolume", "flags": "el", "label": "Volume up", "group": "Media",
                         "action": { "shell": "osd.volume +5" } },
    "windows.resize": { "mods": "SUPER", "key": "mouse:273", "flags": "m", "label": "Resize window", "group": "Windows",
                      "action": { "dsp": "window.resize" } },
    "windows.next": { "mods": "ALT", "key": "TAB", "label": "Focus on next window", "group": "Windows",
                      "action": [ { "dsp": "window.cycle_next" }, { "dsp": "window.bring_to_top" } ] },
    "windows.workspace-1": { "mods": "SUPER", "key": "code:10", "label": "Switch to workspace 1", "group": "Windows",
                             "action": { "dsp": "focus", "args": { "workspace": 1 } } }
  },
  "displays": {
    "DP-1": { "mode": "3440x1440@100", "position": "0x0", "scale": 1 },
    "DP-2": { "mode": "2560x1440@144", "position": "3440x-560", "scale": 1, "transform": 3 }
  },
  "workspaces": {
    "1": { "monitor": "desc:Acer X34", "persistent": true },
    "2": { "monitor": "desc:Acer X34", "persistent": true },
    "10": { "monitor": "DP-2" },
    "9": { "monitor": "desc:BenQ Left", "persistent": true }
  },
  "bar": { "position": "top", "left": ["workspaces", "title"], "centre": ["clock"],
           "right": ["tray", "glyphs", "cog"], "glyphs": ["network", "battery"] },
  "launcher": { "position": "centre" },
  "notifications": { "corner": "top-right", "timeoutMs": 5000 },
  "idle": { "dimSec": 0, "lockSec": 0, "screenOffSec": 0, "suspendSec": 0, "lockOnSleep": true },
  "input": { "kbLayout": "us", "kbVariant": "", "kbOptions": "compose:caps", "repeatRate": 40, "repeatDelay": 600,
             "numlock": true, "sensitivity": 0,
             "touchpad": { "naturalScroll": false, "tapToClick": true, "scrollFactor": 0.4 } },
  "windows": { "opacity": { "active": 0.97, "inactive": 0.9 } },
  "apps": {
    "com.libretro.RetroArch": { "opacity": { "active": 1, "inactive": 1 } },
    "kitty": { "opacity": { "active": 0.9, "inactive": 0.75 }, "monitor": "desc:BenQ Left" },
    "odd\"class\\(x)": { "workspace": 3 },
    "spotify": { "workspace": 9 }
  }
}
