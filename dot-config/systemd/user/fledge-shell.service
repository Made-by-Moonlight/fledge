[Unit]
Description=made by moonlight shell (Quickshell: bar, launcher, notifications, lock)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/qs -c fledge
# A crash restarts it; a shell that crashed while locked re-locks from the relock
# flag (Lock.qml, misc:allow_session_lock_restore).
# Crash loop: after 5 failed starts in 10s systemd gives up (start limit). Recover
# from a TTY (Ctrl+Alt+F3, log in):
#   systemctl --user reset-failed fledge-shell && systemctl --user start fledge-shell
Restart=on-failure
RestartSec=1
# The default, spelled out: stop and restart kill the whole cgroup, so nothing
# the shell started detached (or Quickshell's crash-guard relaunch) outlives it.
KillMode=control-group

[Install]
WantedBy=graphical-session.target
