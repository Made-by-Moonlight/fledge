[Unit]
Description=made by moonlight shell (Quickshell: bar, launcher, notifications, lock)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/qs -c mbm
# Tells Lock.qml systemd restarts it, so it starts no spare of its own.
Environment=MBM_SHELL_SUPERVISED=1
# The lock screen re-acquires a taken-over session lock by exiting 1 (Lock.qml):
# this restarts it, and the new shell re-locks from the relock flag. One restart
# is far below the default start limit (5 in 10s).
Restart=on-failure
RestartSec=1
# The default, spelled out: stop and restart kill the whole cgroup, so nothing
# the shell started detached (or Quickshell's crash-guard relaunch) outlives it.
KillMode=control-group

[Install]
WantedBy=graphical-session.target
