# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#171e28"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f4af03"

# Background color of selected item in processes box
theme[selected_bg]="#6c7787"

# Foreground color of selected item in processes box
theme[selected_fg]="#f4af03"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7787"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ffffff"

# Background color of the percentage meters
theme[meter_bg]="#6c7787"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ffffff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c38fd6"
theme[mem_box]="#8fcf8a"
theme[net_box]="#e5626a"
theme[proc_box]="#f4af03"

# Box divider line and small boxes line color
theme[div_line]="#6c7787"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8fcf8a"
theme[temp_mid]="#f4af03"
theme[temp_end]="#e5626a"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#5fc4c0"
theme[cpu_mid]="#6fa8dc"
theme[cpu_end]="#c38fd6"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#c38fd6"
theme[free_mid]="#6fa8dc"
theme[free_end]="#5fc4c0"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#6fa8dc"
theme[cached_mid]="#5fc4c0"
theme[cached_end]="#c38fd6"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#f4af03"
theme[available_mid]="#e5626a"
theme[available_end]="#e5626a"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#8fcf8a"
theme[used_mid]="#5fc4c0"
theme[used_end]="#6fa8dc"

# Download graph colors (Peach -> Red)
theme[download_start]="#f4af03"
theme[download_mid]="#e5626a"
theme[download_end]="#e5626a"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#8fcf8a"
theme[upload_mid]="#5fc4c0"
theme[upload_end]="#6fa8dc"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#5fc4c0"
theme[process_mid]="#6fa8dc"
theme[process_end]="#c38fd6"
