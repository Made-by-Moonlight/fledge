# Zen browser profile data must never be tracked — only the chrome theme
# file (dot-config/zen/chrome/zen-themes.css) is intentionally committed.
dot-config/zen/*
!dot-config/zen/chrome/
dot-config/zen/chrome/*
!dot-config/zen/chrome/zen-themes.css

# Python bytecode
__pycache__/
# ISO build output (cachyos/iso/bin/slievr-iso-make)
release/
